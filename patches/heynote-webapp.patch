+        // ===== web 版图片保存：dataURL 存 localStorage（wt-images），返回稳定文件名 =====
+        async saveImage({data, mime}) {
+            try {
+                const arr = data instanceof Uint8Array ? data : new Uint8Array(data)
+                let bin = ""
+                const chunk = 0x8000
+                for (let i = 0; i < arr.length; i += chunk) {
+                    bin += String.fromCharCode.apply(null, arr.subarray(i, i + chunk))
+                }
+                const dataUrl = "data:" + (mime || "image/png") + ";base64," + btoa(bin)
+                const filename = "wtimg-" + Date.now().toString(36) + "-" + (++wtImageSeq) + ".png"
+                wtImages[filename] = dataUrl
+                try {
+                    localStorage.setItem("wt-images", JSON.stringify(wtImages))
+                } catch (e) {
+                    console.warn("wt-images persist failed (quota?):", e)
+                }
+                return filename
+            } catch (e) {
+                console.error("saveImage failed:", e)
+                return null
+            }
+        },
