+// ===== web 版图片存储 =====
+// 优先走宿主能力 API（window.unihub，图片落宿主侧 SQLite，无配额限制）；
+// 无宿主环境（纯浏览器）时兜底 localStorage（wt-images，有 5-10MB 配额）。
+// 两种后端都先预载进内存 wtImages，__wtResolveImage 保持同步渲染。
+let wtImageSeq = 0
+const wtImages = (() => {
+    try { return JSON.parse(localStorage.getItem("wt-images") || "{}") } catch (e) { return {} }
+})()
+
+const wtHostStorage = (typeof window !== "undefined" && window.unihub && window.unihub.storage && window.unihub.storage.setBlob)
+    ? window.unihub.storage
+    : null
+
+function wtPreloadImages() {
+    if (!wtHostStorage) return
+    wtHostStorage.blobKeys().then((keys) => {
+        (keys || []).forEach((k) => {
+            if (!wtImages[k]) {
+                wtHostStorage.getBlob(k).then((dataUrl) => {
+                    if (dataUrl) wtImages[k] = dataUrl
+                }).catch(() => {})
+            }
+        })
+    }).catch(() => {})
+}
+wtPreloadImages()
+
+// wtimg-* 文件名 → dataURL（供编辑器 img.src 直接使用；找不到返回 null 走原协议）
+window.__wtResolveImage = function (filename) {
+    if (wtImages[filename]) return wtImages[filename]
+    try {
+        const store = JSON.parse(localStorage.getItem("wt-images") || "{}")
+        if (store[filename]) {
+            wtImages[filename] = store[filename]
+            return store[filename]
+        }
+    } catch (e) { /* 忽略 */ }
+    return null
+}
