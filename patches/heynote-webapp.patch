+// ===== Web 版编辑器右键菜单（对应桌面版 electron/main/menu.js 的 getEditorContextMenu）=====
+let lastContextMenuX = 0
+let lastContextMenuY = 0
+document.addEventListener("contextmenu", (e) => {
+    lastContextMenuX = e.clientX
+    lastContextMenuY = e.clientY
+}, true)
+
+let contextMenuEl = null
+let contextMenuCloseNotify = false
+
+function closeWtMenu() {
+    if (contextMenuEl) {
+        contextMenuEl.remove()
+        contextMenuEl = null
+        document.removeEventListener("mousedown", onDocMouseDown, true)
+        document.removeEventListener("keydown", onDocKeyDown, true)
+        if (contextMenuCloseNotify) {
+            ipcRenderer.send("context-menu-closed")
+        }
+        contextMenuCloseNotify = false
+    }
+}
+
+function onDocMouseDown(e) {
+    if (contextMenuEl && !contextMenuEl.contains(e.target)) closeWtMenu()
+}
+
+function onDocKeyDown(e) {
+    if (e.key === "Escape") closeWtMenu()
+}
+
+// 通用弹出菜单：items = [{label, accel?, checked?, enabled?, sep?, run}]
+// opts = {x, y, notifyClosed}（notifyClosed：关闭时发 context-menu-closed）
+function wtShowMenu(items, opts) {
+    closeWtMenu()
+    const dark = matchMedia("(prefers-color-scheme: dark)").matches
+    const menu = document.createElement("div")
+    menu.className = "wt-ctxmenu"
+    menu.style.cssText =
+        "position:fixed;z-index:2147483647;min-width:220px;max-height:70vh;overflow:auto;padding:4px 0;" +
+        "background:" + (dark ? "#2b2d33" : "#ffffff") + ";" +
+        "border:1px solid rgba(128,128,128,.35);border-radius:8px;" +
+        "box-shadow:0 8px 24px rgba(0,0,0,.25);font:12px -apple-system,'Segoe UI',sans-serif;"
+    for (const it of items) {
+        if (it.sep) {
+            const sep = document.createElement("div")
+            sep.style.cssText = "height:1px;margin:4px 8px;background:rgba(128,128,128,.3)"
+            menu.appendChild(sep)
+            continue
+        }
+        const row = document.createElement("div")
+        row.style.cssText =
+            "display:flex;align-items:center;justify-content:space-between;gap:24px;padding:5px 12px;" +
+            (it.enabled === false
+                ? "cursor:default;opacity:.4;"
+                : "cursor:pointer;color:" + (dark ? "#e6e6e6" : "#222") + ";")
+        if (it.checked !== undefined) {
+            const box = document.createElement("span")
+            box.style.cssText = "width:14px;flex:none;" + (it.checked ? "" : "color:transparent")
+            box.textContent = "✓"
+            row.appendChild(box)
+        }
+        const label = document.createElement("span")
+        label.style.cssText = "flex:1;white-space:nowrap"
+        label.textContent = (it.checked !== undefined ? "  " : "") + it.label
+        row.appendChild(label)
+        const accel = document.createElement("span")
+        accel.style.cssText = "opacity:.55;font-size:11px"
+        accel.textContent = it.accel || ""
+        row.appendChild(accel)
+        if (it.enabled !== false) {
+            row.onmouseenter = () => { row.style.background = "rgba(70,130,220,.18)" }
+            row.onmouseleave = () => { row.style.background = "transparent" }
+            row.onmousedown = (e) => { e.preventDefault(); e.stopPropagation() }
+            row.onclick = () => { closeWtMenu(); try { it.run && it.run() } catch (err) { console.error(err) } }
+        }
